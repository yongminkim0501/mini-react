{
  "name": "mini-react",
  "version": "1.0.0",
  "private": true,
  "description": "크래프톤 정글 11주차 미니 리액트 구현",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/ci/run-tests.mjs",
    "test:run": "npm test",
    "lint": "oxlint --config .oxlintrc.json --disable-nested-config --deny-warnings .",
    "test:watch": "vitest",
    "check": "npm run lint && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yongminkim0501/mini-react.git"
  },
  "bugs": {
    "url": "https://github.com/yongminkim0501/mini-react/issues"
  },
  "homepage": "https://github.com/yongminkim0501/mini-react#readme",
  "devDependencies": {
    "jsdom": "^31.0.0",
    "oxlint": "1.92.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
